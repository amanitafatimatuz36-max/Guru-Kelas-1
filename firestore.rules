rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Check if user is admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'amanita.fatimatuz36@guru.sd.belajar.id' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Check if user is a teacher with specific class responsibility or subject teacher
    function getTeacherData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAuthorizedForClass(kelas) {
      return isAdmin() || (
        isSignedIn() && (
          getTeacherData().tanggungJawab == kelas ||
          getTeacherData().tanggungJawab == 'Pendidikan Agama Islam' ||
          getTeacherData().tanggungJawab == 'PJOK'
        )
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isCurrentUser(userId);
    }

    // Global School Settings
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        getTeacherData().tanggungJawab == resource.data.kelas ||
        getTeacherData().tanggungJawab == 'Pendidikan Agama Islam' ||
        getTeacherData().tanggungJawab == 'PJOK'
      );
      allow write: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.kelas == getTeacherData().tanggungJawab)
      );
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.kelas == getTeacherData().tanggungJawab
      );
    }

    // Attendances Collection
    match /attendances/{attendanceId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.guruId == request.auth.uid ||
        isAuthorizedForClass(resource.data.kelas)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.guruId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.guruId == request.auth.uid
      );
    }

    // Grades Collection (Penilaian Harian per bab)
    match /grades/{gradeId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.guruId == request.auth.uid ||
        isAuthorizedForClass(resource.data.kelas)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.guruId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.guruId == request.auth.uid
      );
    }

    // Journals Collection (Catatan Mengajar)
    match /journals/{journalId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.guruId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.guruId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.guruId == request.auth.uid
      );
    }

    // Counselings Collection (Bimbingan Siswa)
    match /counselings/{counselingId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.guruId == request.auth.uid ||
        isAuthorizedForClass(resource.data.kelas)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.guruId == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.guruId == request.auth.uid
      );
    }
  }
}
